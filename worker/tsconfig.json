{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/vitest-plugin/types"],
    "paths": { "@/*": ["../*"] }
  },
  "include": ["./**/*.ts", "../worker-configuration.d.ts", "../lib/shared/**/*.ts", "../test/**/*.ts"]
}
