{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "church-bot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],

  // The dashboard is a Next.js static export (`next build` → ./out). Static
  // files are served free and don't count toward the 100k requests a day; only
  // these paths reach the Worker.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/webhook", "/media/*", "/health"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "church-bot",
      // Filled in by `npx wrangler d1 create church-bot` (Phase 3).
      "database_id": "09532b69-ace7-4b45-90ed-4ba4e2af14c0",
      "migrations_dir": "migrations"
    }
  ],

  // 02:00 India time: clear old dedup ids, expired chats, sessions and logins.
  "triggers": { "crons": ["30 20 * * *"] },

  "observability": { "enabled": true },

  "vars": {
    // The version in the sample request on Meta → WhatsApp → API Setup.
    "GRAPH_API_VERSION": "v24.0",
    "DRY_RUN": "false"
  }
  // Secrets, uploaded with `npx wrangler secret bulk` (this repo is public, so
  // phone numbers and Meta ids stay out of it too):
  //   WHATSAPP_TOKEN, APP_SECRET, VERIFY_TOKEN
  //   PHONE_NUMBER_ID   Meta → WhatsApp → API Setup
  //   BOT_NUMBER        the bot's WhatsApp number, digits with country code (wa.me links)
  //   OWNER_PHONE       the first admin's WhatsApp number, digits with country code
  //   MAIL_RELAY_URL, MAIL_RELAY_KEY (optional, apps-script/Code.gs)
}
