{
  "name": "church-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "wrangler dev",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "simulate": "node scripts/simulate.mjs",
    "deploy": "next build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "packageManager": "pnpm@10.28.2"
}
